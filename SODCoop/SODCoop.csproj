<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" />
		<PackageReference Include="LiteNetLib" Version="2.1.4" />
		<PackageReference Include="SOD.Common" Version="2.1.5" />
	</ItemGroup>

	<PropertyGroup>
		<GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\Shadows of Doubt</GameDir>
		<InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(InteropDir)\*.dll" Private="false" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployTo)' != ''">
		<ItemGroup>
			<DeployDir Include="$([MSBuild]::Unescape($(DeployTo)))" />
		</ItemGroup>
		<Copy SourceFiles="$(TargetDir)SodCoop.dll;$(TargetDir)LiteNetLib.dll" DestinationFolder="%(DeployDir.Identity)\BepInEx\plugins" />
	</Target>

</Project>
